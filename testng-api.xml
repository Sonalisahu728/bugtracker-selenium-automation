<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- API only: fast, needs no browser. -->
<suite name="BugTrack - API" verbose="1">
  <test name="API">
    <groups>
      <run>
        <exclude name="known-defect"/>
      </run>
    </groups>
    <packages>
      <package name="com.bugtracker.automation.api"/>
    </packages>
  </test>
</suite>
